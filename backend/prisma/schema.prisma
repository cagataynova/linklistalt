generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ContentStatus {
  ACTIVE
  PENDING_REVIEW
  HIDDEN
  REMOVED
}

enum ListVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum ReportTargetType {
  USER
  PROFILE
  LIST
  PRODUCT
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  NOTE
  HIDE
  REMOVE
  RESTORE
  SUSPEND_USER
  RESTORE_USER
}

enum UploadStatus {
  PENDING
  READY
  ATTACHED
  REJECTED
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  firebaseUid       String             @unique
  email             String             @unique
  emailVerified     Boolean            @default(false)
  role              UserRole           @default(USER)
  status            UserStatus         @default(ACTIVE)
  profile           Profile?
  lists             List[]
  products          Product[]
  uploads           UploadIntent[]
  followers         Follow[]           @relation("FollowTarget")
  following         Follow[]           @relation("FollowSource")
  listLikes         ListLike[]
  blocksInitiated   Block[]            @relation("BlockSource")
  blocksReceived    Block[]            @relation("BlockTarget")
  reports           Report[]           @relation("ReportAuthor")
  invitesCreated    InviteCode[]       @relation("InviteCreator")
  redemptions       InviteRedemption[]
  moderationActions ModerationAction[] @relation("ModerationActor")
  auditLogs         AuditLog[]         @relation("AuditActor")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  @@index([status, createdAt])
}

model Profile {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @unique @db.Uuid
  username      String        @unique
  displayName   String
  bio           String?
  avatarUrl     String?
  contentStatus ContentStatus @default(ACTIVE)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([username, contentStatus])
}

model List {
  id            String         @id @default(uuid()) @db.Uuid
  ownerId       String         @db.Uuid
  title         String
  description   String?
  category      String
  visibility    ListVisibility @default(PRIVATE)
  shareToken    String?        @unique
  contentStatus ContentStatus  @default(ACTIVE)
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listProducts  ListProduct[]
  likes         ListLike[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([ownerId, updatedAt])
  @@index([visibility, contentStatus, updatedAt])
}

model Product {
  id                  String         @id @default(uuid()) @db.Uuid
  ownerId             String         @db.Uuid
  clonedFromProductId String?        @db.Uuid
  name                String
  brand               String?
  price               Decimal?       @db.Decimal(12, 2)
  currency            String         @default("TRY") @db.VarChar(3)
  sourceUrl           String
  note                String?
  savedPriceAt        DateTime?
  contentStatus       ContentStatus  @default(ACTIVE)
  owner               User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  clonedFrom          Product?       @relation("ProductClones", fields: [clonedFromProductId], references: [id], onDelete: SetNull)
  clones              Product[]      @relation("ProductClones")
  images              ProductImage[]
  listProducts        ListProduct[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([ownerId, createdAt])
  @@index([clonedFromProductId])
  @@index([contentStatus])
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  storageKey String   @unique
  publicUrl  String
  sourceUrl  String?
  position   Int      @default(0)
  width      Int?
  height     Int?
  mimeType   String   @default("image/webp") @db.VarChar(100)
  altText    String?
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, position])
  @@index([productId])
}

model ListProduct {
  listId    String   @db.Uuid
  productId String   @db.Uuid
  position  Int      @default(0)
  addedAt   DateTime @default(now())
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([listId, productId])
  @@index([listId, position])
  @@index([productId])
}

model Follow {
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  follower    User     @relation("FollowSource", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("FollowTarget", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId, createdAt])
}

model ListLike {
  userId    String   @db.Uuid
  listId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listId])
  @@index([listId, createdAt])
}

model Block {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  blocker   User     @relation("BlockSource", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model InviteCode {
  id          String             @id @default(uuid()) @db.Uuid
  codeHash    String             @unique
  codePrefix  String
  label       String?
  maxUses     Int
  useCount    Int                @default(0)
  isActive    Boolean            @default(true)
  expiresAt   DateTime?
  createdById String             @db.Uuid
  createdBy   User               @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tickets     SignupTicket[]
  redemptions InviteRedemption[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([isActive, expiresAt])
}

model SignupTicket {
  id           String     @id @default(uuid()) @db.Uuid
  tokenHash    String     @unique
  inviteCodeId String     @db.Uuid
  inviteCode   InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([expiresAt, consumedAt])
}

model InviteRedemption {
  id           String     @id @default(uuid()) @db.Uuid
  inviteCodeId String     @db.Uuid
  userId       String     @unique @db.Uuid
  inviteCode   InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Restrict)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([inviteCodeId, createdAt])
}

model UploadIntent {
  id         String       @id @default(uuid()) @db.Uuid
  ownerId    String       @db.Uuid
  storageKey String       @unique
  mimeType   String       @db.VarChar(100)
  byteSize   Int
  status     UploadStatus @default(PENDING)
  owner      User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([ownerId, status])
  @@index([expiresAt])
}

model Report {
  id         String           @id @default(uuid()) @db.Uuid
  reporterId String           @db.Uuid
  targetType ReportTargetType
  targetId   String
  reason     String
  details    String?
  status     ReportStatus     @default(OPEN)
  reporter   User             @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model ModerationAction {
  id         String               @id @default(uuid()) @db.Uuid
  actorId    String               @db.Uuid
  targetType ReportTargetType
  targetId   String
  action     ModerationActionType
  note       String?
  actor      User                 @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt  DateTime             @default(now())

  @@index([targetType, targetId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String
  metadata   Json?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
}
